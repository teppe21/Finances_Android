<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Backup is disabled in the manifest (allowBackup="false");
     these rules additionally exclude every app data domain in case a vendor build ignores it. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
